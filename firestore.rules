rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isShortText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function bottlePath(bottleId) {
      return /databases/$(database)/documents/bottles/$(bottleId);
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /bottles/{bottleId} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && isShortText(request.resource.data.content, 300)
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && request.resource.data.status == "drifting";

      allow read: if signedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.status in ["drifting", "picked", "replied"]
        );

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "updatedAt"])
        && request.resource.data.status in ["picked", "replied", "archived"];

      allow delete: if false;
    }

    match /replies/{replyId} {
      allow create: if signedIn()
        && exists(bottlePath(request.resource.data.bottleId))
        && request.resource.data.receiverId == request.auth.uid
        && isShortText(request.resource.data.message, 500)
        && request.resource.data.itemType in ["text", "hug", "tea", "pat", "star_bottle"]
        && request.resource.data.thanked == false;

      allow read: if signedIn()
        && (
          resource.data.receiverId == request.auth.uid
          || get(bottlePath(resource.data.bottleId)).data.senderId == request.auth.uid
        );

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["thanked"])
        && get(bottlePath(resource.data.bottleId)).data.senderId == request.auth.uid;

      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ["bottle", "reply", "user"]
        && request.resource.data.targetId is string
        && request.resource.data.reason in ["harassment", "self_harm", "spam", "unsafe", "other"];

      allow read, update, delete: if false;
    }
  }
}
